# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or real credentials.

# --- Supabase (create your own project at https://supabase.com) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-side only, never expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Owner account bootstrap (used by `npm run create-owner` / `npm run reset-password`) ---
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Remotion Lambda (only needed if you swap local rendering for AWS Lambda) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
REMOTION_AWS_LAMBDA_FUNCTION_NAME=
REMOTION_AWS_BUCKET_NAME=

# --- Feature toggles ---
# Off by default — yt-dlp URL ingestion carries ToS/legal caveats, read up before enabling.
ENABLE_URL_INGESTION=false
